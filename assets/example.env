# Gardener Plugin Configuration
# Copy this to your profile's .env file and fill in the values

# PostgreSQL
# Example DSN format (replace all values)
GARDENER_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# S3-compatible storage (MinIO, AWS S3, Cloudflare R2, Backblaze B2, Wasabi, ...)
# Leave GARDENER_S3_ENDPOINT blank for AWS S3 default.
# Legacy GARDENER_MINIO_* names are still accepted for backwards compatibility.
GARDENER_S3_ENDPOINT=https://your-s3-endpoint.example.com
GARDENER_S3_ACCESS_KEY=your-access-key
GARDENER_S3_SECRET_KEY=your-secret-key
GARDENER_S3_BUCKET=plant-photos
GARDENER_S3_REGION=us-east-1

# Optional: use no-S3 mode by leaving S3 vars unset.

# Telegram Bot Token
# Get from @BotFather on Telegram
GARDENER_TELEGRAM_BOT_TOKEN=1234567890:replace_with_real_token

# Pl@ntNet API — primary plant identification
PLANTNET_API_KEY=your-plantnet-key-here
